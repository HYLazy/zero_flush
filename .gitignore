
# 构建产物：zf_valcheck 由本仓库新增目标生成（其余 build_rel 产物已在既有规则内）
source/rocksdb-zeroflush/build_rel/zf_valcheck

# in-source cmake 构建残留（诊断期临时用；正式构建走 build_rel）
source/rocksdb-zeroflush/zf_valcheck
source/rocksdb-zeroflush/db_bench
source/rocksdb-zeroflush/librocksdb.so*
source/rocksdb-zeroflush/build_version.cc
source/rocksdb-zeroflush/tools/Makefile
source/rocksdb-zeroflush/db_stress_tool/Makefile
source/rocksdb-zeroflush/third-party/gtest-1.8.1/fused-src/gtest/Makefile
source/rocksdb-zeroflush/CMakeCache.txt
source/rocksdb-zeroflush/CMakeFiles/
source/rocksdb-zeroflush/cmake_install.cmake
source/rocksdb-zeroflush/CTestTestfile.cmake

# ZF 实验产物：原始日志与实验库不入库，改为在 RUN_MANIFEST.md 记录配置与结果
output/**/*.LOG
output/**/fill_*.log
output/**/db_*/
# 冻结样本副本（保留证据用；每次追踪用新副本，避免反复重开改变证据）
output/**/frozen_*/
# 压力/验收实验目录（每组一个父目录，内含 per-iteration 库）
output/**/st_*/
output/**/it_*/

# 实验导出包：可由 output/report/catalog（主动）与 archive/catalog（存档）的元数据
# + 原始数据重新生成：
#   python3 output/report/catalog/export_bundle.py export --all
#   python3 output/report/catalog/export_bundle.py export --all --scope archived
# 故只入库两侧的导出清单 index.json，不入库 .zexp 本体（主动 ~109 MiB + 存档 ~19 MiB）
output/bundles/*.zexp
archive/bundles/*.zexp

# V2 验收用的独立测试构建目录（zf_test 需 -Wno-error=format-truncation，见 V2_DESIGN.md）
source/rocksdb-zeroflush/build_test/

# ---- 2026-10-20 收尾清理追加 ----
