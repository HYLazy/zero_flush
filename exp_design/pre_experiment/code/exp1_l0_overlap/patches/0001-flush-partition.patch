+// Iterator wrapper that restricts iteration to a contiguous user-key subrange
+// [lower, upper] of an underlying InternalIterator.  Used by the
+// flush-time partitioned emission path in WriteLevel0Table() to split a
+// single memtable scan into P non-overlapping SST outputs whose key ranges
+// are aligned with current L1 file boundaries.
+//
+// Semantics:
+//   * lower_bound (exclusive): if non-null/non-empty, SeekToFirst() positions
+//     at the first entry whose user key is strictly greater than lower_bound.
+//   * upper_bound (inclusive): if non-null/non-empty, Valid() becomes false
+//     once the underlying iterator advances past the last entry whose user
+//     key <= upper_bound.
+class PartitionBoundedIterator : public InternalIterator {
+ public:
+  PartitionBoundedIterator(InternalIterator* inner, const Slice* lower_bound,
+                           const Slice* upper_bound, const Comparator* ucmp)
+      : inner_(inner),
+        lower_bound_(lower_bound),
+        upper_bound_(upper_bound),
+        ucmp_(ucmp),
+        valid_(false) {}
+
+  bool Valid() const override { return valid_ && inner_->Valid(); }
+
+  void SeekToFirst() override {
+    if (lower_bound_ != nullptr && !lower_bound_->empty()) {
+      // Construct the largest possible internal key for this user key so that
+      // Seek() lands on the first entry with user key strictly greater than
+      // lower_bound_ (exclusive lower bound).
+      seek_key_.SetMaxPossibleForUserKey(*lower_bound_);
+      inner_->Seek(seek_key_.Encode());
+    } else {
+      inner_->SeekToFirst();
+    }
+    UpdateValid();
+  }
+
+  void SeekToLast() override {
+    inner_->SeekToLast();
+    UpdateValid();
+  }
+
+  void Seek(const Slice& target) override {
+    inner_->Seek(target);
+    UpdateValid();
+  }
+
+  void SeekForPrev(const Slice& target) override {
+    inner_->SeekForPrev(target);
+    UpdateValid();
+  }
+
+  void Next() override {
+    inner_->Next();
+    UpdateValid();
+  }
+
+  void Prev() override {
+    inner_->Prev();
+    UpdateValid();
+  }
+
+  Slice key() const override { return inner_->key(); }
+  Slice value() const override { return inner_->value(); }
+  Status status() const override { return inner_->status(); }
+
+ private:
+  void UpdateValid() {
+    valid_ = inner_->Valid();
+    if (!valid_) {
+      return;
+    }
+    if (upper_bound_ != nullptr && !upper_bound_->empty()) {
+      Slice uk = ExtractUserKey(inner_->key());
+      if (ucmp_->Compare(uk, *upper_bound_) > 0) {
+        valid_ = false;
+      }
+    }
+  }
+
+  InternalIterator* inner_;
+  const Slice* lower_bound_;  // exclusive, nullable
+  const Slice* upper_bound_;  // inclusive, nullable
+  const Comparator* ucmp_;
+  InternalKey seek_key_;
+  bool valid_;
+};
+
