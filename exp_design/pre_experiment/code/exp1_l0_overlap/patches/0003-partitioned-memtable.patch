+void ColumnFamilyData::UpdatePartitionBoundaries() {
+  if (!mem_ || !mem_->IsPartitioned()) {
+    return;
+  }
+  auto* pmem = static_cast<PartitionedMemTable*>(mem_);
+  const auto* vstorage = current_->storage_info();
+  const auto& l1_files = vstorage->LevelFiles(1);
+  std::vector<std::string> l1_boundaries;
+  int P = pmem->num_partitions();
+
+  if (!l1_files.empty()) {
+    std::string smallest_key, largest_key;
+    for (const auto& f : l1_files) {
+      Slice sk = ExtractUserKey(f->smallest.Encode());
+      Slice lk = ExtractUserKey(f->largest.Encode());
+      if (smallest_key.empty() || sk.compare(smallest_key) < 0) {
+        smallest_key = sk.ToString();
+      }
+      if (largest_key.empty() || lk.compare(largest_key) > 0) {
+        largest_key = lk.ToString();
+      }
+    }
+    if (l1_files.size() >= static_cast<size_t>(P - 1)) {
+      for (int i = 0; i < P - 1; i++) {
+        int idx = static_cast<int>(
+            static_cast<int64_t>(i + 1) * l1_files.size() / P);
+        idx = std::min(idx, static_cast<int>(l1_files.size()) - 1);
+        l1_boundaries.push_back(
+            ExtractUserKey(l1_files[idx]->largest.Encode()).ToString());
+      }
+    } else {
+      // Not enough L1 files: compute P-1 evenly spaced boundaries
+      size_t klen = smallest_key.size();
+      std::vector<uint8_t> diff(klen, 0);
+      int borrow = 0;
+      for (int i = static_cast<int>(klen) - 1; i >= 0; i--) {
+        int d = static_cast<uint8_t>(largest_key[i]) -
+                static_cast<uint8_t>(smallest_key[i]) - borrow;
+        if (d < 0) { d += 256; borrow = 1; } else { borrow = 0; }
+        diff[i] = static_cast<uint8_t>(d);
+      }
+      for (int k = 1; k < P; k++) {
+        std::vector<uint32_t> mul(klen, 0);
+        uint32_t carry = 0;
+        for (int i = static_cast<int>(klen) - 1; i >= 0; i--) {
+          uint32_t val = static_cast<uint32_t>(k) * diff[i] + carry;
+          mul[i] = val & 0xFF;
+          carry = val >> 8;
+        }
+        uint32_t rem = carry;
+        std::string boundary(klen, '\0');
+        for (size_t i = 0; i < klen; i++) {
+          rem = (rem << 8) | mul[i];
+          boundary[i] = static_cast<char>(rem / P);
+          rem = rem % P;
+        }
+        int add_carry = 0;
+        for (int i = static_cast<int>(klen) - 1; i >= 0; i--) {
+          int val = static_cast<uint8_t>(smallest_key[i]) +
+                    static_cast<uint8_t>(boundary[i]) + add_carry;
+          if (val >= 256) { val -= 256; add_carry = 1; } else { add_carry = 0; }
+          boundary[i] = static_cast<char>(val);
+        }
+        l1_boundaries.push_back(boundary);
+      }
+    }
+  }
+  pmem->UpdateBoundaries(l1_boundaries);
+  ROCKS_LOG_INFO(ioptions_.info_log,
+                  "[%s] UpdatePartitionBoundaries: L1_files=%zu, "
+                  "boundaries_set=%zu, num_partitions=%d\n",
+                  GetName().c_str(), l1_files.size(),
+                  l1_boundaries.size(), P);
+}
