+// exp1: Switch a single full sub-table of a PartitionedMemTable.
+// Extracts the full sub-table, marks it immutable, adds it to the
+// immutable memtable list, creates a replacement, and installs a new
+// SuperVersion. No new WAL is created — sub-tables share the active WAL.
+Status DBImpl::SwitchPartitionedSubTable(ColumnFamilyData* cfd,
+                                         WriteContext* context) {
+  mutex_.AssertHeld();
+  assert(cfd->mem()->IsPartitioned());
+
+  auto* pmem = static_cast<PartitionedMemTable*>(cfd->mem());
+
+  // Update partition boundaries from current L1 state before switching
+  cfd->UpdatePartitionBoundaries();
+
+  // Extract the full sub-table (also creates replacement)
+  MemTable* full_sub = pmem->TakeFullSubTable();
+  if (full_sub == nullptr) {
+    // Race: no full sub-table found. Reset and return OK.
+    pmem->ResetFlushState();
+    return Status::OK();
+  }
+
+  // Set the next log number so the immutable sub-table references the
+  // current active WAL (same WAL, not switching)
+  full_sub->SetNextLogNumber(cur_wal_number_);
+
+  // Assign memtable ID so PickMemtablesToFlush can pick it up
+  cfd->AssignMemtableID(full_sub);
+
+  // Add the full sub-table to the immutable memtable list.
+  // The imm list takes over the reference (refs=1 from TakeFullSubTable).
+  cfd->imm()->Add(full_sub, &context->memtables_to_free_);
+
+  // Install new SuperVersion so reads see the replacement sub-table.
+  context->superversion_context.NewSuperVersion();
+  InstallSuperVersionAndScheduleWork(cfd, &context->superversion_context);
+
+  // Update partition boundaries for the new sub-table arrangement
+  cfd->UpdatePartitionBoundaries();
+
+  ROCKS_LOG_INFO(immutable_db_options_.info_log,
+                  "[%s] PartitionedMemTable sub-table flushed (id=%" PRIu64
+                  "), replacement created. Immutable: %d\n",
+                  cfd->GetName().c_str(), full_sub->GetID(),
+                  cfd->imm()->NumNotFlushed());
+
+  return Status::OK();
+}
