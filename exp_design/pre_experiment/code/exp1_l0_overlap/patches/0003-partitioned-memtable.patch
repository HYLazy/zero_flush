+//  Copyright (c) 2011-present, Facebook, Inc.  All rights reserved.
+//  This source code is licensed under both the GPLv2 (found in the
+//  COPYING file in the root directory) and Apache 2.0 License
+//  (found in the LICENSE.Apache file in the root directory).
+//
+// PartitionedMemTable: P sub-MemTables with write-time key-range routing.
+// Each sub-table flushes independently → 1 SST per flush (not P).
+// Total memory budget = write_buffer_size (each sub-table gets wbs/P).
+//
+// This is the "main approach" for exp1: writes are routed to the correct
+// sub-table at admission time by L1 key-range boundaries, proving that
+// L0 overlap is decided at write admission, not at flush.
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "db/dbformat.h"
+#include "db/memtable.h"
+#include "memory/allocator.h"
+#include "monitoring/instrumented_mutex.h"
+#include "options/cf_options.h"
+#include "port/port.h"
+#include "rocksdb/memtablerep.h"
+#include "util/autovector.h"
+
+namespace ROCKSDB_NAMESPACE {
+
+class PartitionedMemTable : public MemTable {
+ public:
+  // Static configuration: set before DB open via db_bench flag.
+  // 0 = disabled (vanilla single MemTable), >0 = P partitions.
+  static int num_partitions_config;
+  static bool enabled() { return num_partitions_config > 0; }
+
+  PartitionedMemTable(const InternalKeyComparator& comparator,
+                      const ImmutableOptions& ioptions,
+                      const MutableCFOptions& mutable_cf_options,
+                      WriteBufferManager* write_buffer_manager,
+                      SequenceNumber earliest_seq, uint32_t column_family_id,
+                      int num_partitions);
+
+  ~PartitionedMemTable() override;
+
+  const char* Name() const override { return "PartitionedMemTable"; }
+
+  bool IsPartitioned() const override { return true; }
+
+  // === Write path: route to correct sub-table by L1 boundaries ===
+  Status Add(SequenceNumber seq, ValueType type, const Slice& key,
+             const Slice& value, const ProtectionInfoKVOS64* kv_prot_info,
+             bool allow_concurrent = false,
+             MemTablePostProcessInfo* post_process_info = nullptr,
+             void** hint = nullptr) override;
+
+  // === Flush management ===
+  bool ShouldFlushNow() override;
+  bool ShouldScheduleFlush() const override;
+  bool MarkFlushScheduled() override;
+  void UpdateFlushState() override;
+
+  // Per-sub-table flush: extract the full sub-table for independent flushing.
+  // Returns the full sub-table (caller owns the ref) or nullptr if none full.
+  // The sub-table is marked immutable and removed from the active set.
+  // A replacement sub-table is created in its slot.
+  // REQUIRES: DB mutex held.
+  MemTable* TakeFullSubTable();
+  bool HasFullSubTable() const;
+
+  // Reset flush scheduling state after a sub-table flush has been initiated.
+  void ResetFlushState();
+
+  // === Read path: merge all sub-table iterators ===
+  InternalIterator* NewIterator(const ReadOptions& read_options,
+                                 UnownedPtr<const SeqnoToTimeMapping> seqno_to_time_mapping,
+                                 Arena* arena,
+                                 const SliceTransform* prefix_extractor,
+                                 bool for_flush) override;
+
+  bool Get(const LookupKey& key, std::string* value,
+           PinnableWideColumns* columns, std::string* timestamp, Status* s,
+           MergeContext* merge_context,
+           SequenceNumber* max_covering_tombstone_seq, SequenceNumber* seq,
+           const ReadOptions& read_opts, bool immutable_memtable,
+           ReadCallback* callback = nullptr, bool* is_blob_index = nullptr,
+           bool do_merge = true) override;
+
+  // === Stats ===
+  size_t ApproximateMemoryUsage() override;
+  size_t MemoryAllocatedBytes() const override;
+  uint64_t NumEntries() const override;
+  uint64_t NumDeletion() const override;
+  uint64_t NumRangeDeletion() const override;
+  uint64_t GetDataSize() const override;
+  bool IsEmpty() const override;
+  SequenceNumber GetFirstSequenceNumber() override;
+  SequenceNumber GetEarliestSequenceNumber() override;
+  uint64_t ApproximateOldestKeyTime() const override;
+  size_t write_buffer_size() const;
+
+  // === Boundary management ===
+  // Update partition boundaries from L1 file metadata.
+  // Called when a new SuperVersion is installed (boundaries may change
+  // after L0→L1 compaction). If L1 is empty, falls back to uniform
+  // key-space splitting.
+  void UpdateBoundaries(const std::vector<std::string>& l1_boundary_keys);
+
+  // Get the partition index for a given user key (binary search on boundaries).
+  int GetPartitionIndex(const Slice& user_key) const;
+
+  // Number of partitions
+  int num_partitions() const { return num_partitions_; }
+
+  // Access sub-tables (for testing/debugging)
+  MemTable* GetSubTable(int idx) const { return sub_tables_[idx]; }
+
+ private:
+  int num_partitions_;
+  // Sub-tables are ref-counted (refs=1 owned by PartitionedMemTable).
+  // When a sub-table is taken for flush, ownership transfers to the
+  // immutable memtable list.
+  std::vector<MemTable*> sub_tables_;
+
+  // Partition boundaries: user_key upper-bounds for partitions 0..P-2.
+  // Partition i covers keys in (boundaries_[i-1], boundaries_[i]].
+  // boundaries_[0] is the upper bound of partition 0.
+  // If empty, uses uniform key-space splitting.
+  std::vector<std::string> boundaries_;
+
+  // Constructor params stored for creating replacement sub-tables
+  const InternalKeyComparator& comparator_;
+  const ImmutableOptions ioptions_;
+  MutableCFOptions mutable_cf_options_;
+  WriteBufferManager* write_buffer_manager_;
+  uint32_t column_family_id_;
+  size_t sub_table_buffer_size_;  // write_buffer_size / P
+
+  // Flush state: atomic flag for "a sub-table is full and needs flush"
+  std::atomic<bool> partition_flush_pending_{false};
+  std::atomic<int> full_partition_idx_{-1};
+
+  // Reader-writer spinlock: protects sub_tables_ and boundaries_ from
+  // concurrent modification by the flush thread while write threads are
+  // reading. Write threads (Add, Get, NewIterator, stats) take read lock
+  // (concurrent reads allowed). Flush thread (TakeFullSubTable,
+  // UpdateBoundaries) takes write lock (exclusive, waits for all readers).
+  // This prevents use-after-free: TakeFullSubTable waits for all in-flight
+  // Add() calls to complete before replacing the sub-table pointer.
+  mutable std::atomic<int> rw_reader_count_{0};
+  mutable std::atomic<bool> rw_writer_active_{false};
+
+  void ReadLock() const;
+  void ReadUnlock() const;
+  void WriteLock();
+  void WriteUnlock();
+
+  // Create a new sub-table with the per-partition buffer size
+  MemTable* CreateSubTable(SequenceNumber earliest_seq);
+};
+
+}  // namespace ROCKSDB_NAMESPACE
