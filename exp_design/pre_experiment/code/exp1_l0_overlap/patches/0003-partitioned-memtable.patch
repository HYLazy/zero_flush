+// Static config: 0 = disabled (default)
+int PartitionedMemTable::num_partitions_config = 0;
+
+PartitionedMemTable::PartitionedMemTable(
+    const InternalKeyComparator& comparator,
+    const ImmutableOptions& ioptions,
+    const MutableCFOptions& mutable_cf_options,
+    WriteBufferManager* write_buffer_manager,
+    SequenceNumber earliest_seq, uint32_t column_family_id,
+    int num_partitions)
+    : MemTable(comparator, ioptions, mutable_cf_options, write_buffer_manager,
+               earliest_seq, column_family_id),
+      num_partitions_(num_partitions),
+      comparator_(comparator),
+      ioptions_(ioptions),
+      mutable_cf_options_(mutable_cf_options),
+      write_buffer_manager_(write_buffer_manager),
+      column_family_id_(column_family_id),
+      sub_table_buffer_size_(mutable_cf_options.write_buffer_size /
+                             num_partitions) {
+  // Create P sub-tables, each with wbs/P buffer size
+  sub_tables_.reserve(num_partitions_);
+  for (int i = 0; i < num_partitions; i++) {
+    MemTable* sub = CreateSubTable(earliest_seq);
+    sub_tables_.push_back(sub);
+  }
+  // boundaries_ starts empty. When empty, GetPartitionIndex uses
+  // hash-based routing as a fallback. Once L1 files exist,
+  // UpdatePartitionBoundaries() will set correct key-range boundaries
+  // from L1 file metadata. This avoids the problem of guessing the
+  // key distribution before any data has been written.
+  // The hash-based fallback distributes keys evenly across partitions,
+  // but produces overlapping SSTs (each covers the full key range).
+  // These are quickly compacted to L1, after which range-based routing
+  // produces non-overlapping SSTs.
+}
+
+PartitionedMemTable::~PartitionedMemTable() {
+  // Unref all sub-tables (each has refs=1 from CreateSubTable)
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      delete sub_tables_[i]->Unref();
+    }
+  }
+}
+
+MemTable* PartitionedMemTable::CreateSubTable(SequenceNumber earliest_seq) {
+  // Create a MutableCFOptions with reduced write_buffer_size for sub-table
+  MutableCFOptions sub_opts = mutable_cf_options_;
+  sub_opts.write_buffer_size = sub_table_buffer_size_;
+  // max_write_buffer_number: keep same; each sub-table gets same count
+  auto* sub = new MemTable(comparator_, ioptions_, sub_opts,
+                           write_buffer_manager_, earliest_seq,
+                           column_family_id_);
+  // Ref so PartitionedMemTable owns it (refs=1)
+  sub->Ref();
+  return sub;
+}
+
+void PartitionedMemTable::ReadLock() const {
+  while (true) {
+    while (rw_writer_active_.load(std::memory_order_acquire)) {}
+    rw_reader_count_.fetch_add(1, std::memory_order_acquire);
+    if (!rw_writer_active_.load(std::memory_order_acquire)) break;
+    rw_reader_count_.fetch_sub(1, std::memory_order_release);
+  }
+}
+
+void PartitionedMemTable::ReadUnlock() const {
+  rw_reader_count_.fetch_sub(1, std::memory_order_release);
+}
+
+void PartitionedMemTable::WriteLock() {
+  bool expected = false;
+  while (!rw_writer_active_.compare_exchange_weak(
+      expected, true, std::memory_order_acquire, std::memory_order_relaxed)) {
+    expected = false;
+  }
+  while (rw_reader_count_.load(std::memory_order_acquire) > 0) {}
+}
+
+void PartitionedMemTable::WriteUnlock() {
+  rw_writer_active_.store(false, std::memory_order_release);
+}
+
+int PartitionedMemTable::GetPartitionIndex(const Slice& user_key) const {
+  if (boundaries_.empty()) {
+    // No boundaries: hash-based distribution
+    // Use simple hash to distribute
+    size_t h = std::hash<std::string>{}(user_key.ToString());
+    return static_cast<int>(h % num_partitions_);
+  }
+
+  // Binary search: find the first boundary >= user_key
+  // Partition i covers keys in (boundaries_[i-1], boundaries_[i]]
+  // For partition 0: keys <= boundaries_[0]
+  // For partition P-1: keys > boundaries_[P-2]
+  int lo = 0, hi = static_cast<int>(boundaries_.size()) - 1;
+  int result = static_cast<int>(boundaries_.size());  // default: last partition
+  while (lo <= hi) {
+    int mid = lo + (hi - lo) / 2;
+    if (user_key.compare(Slice(boundaries_[mid])) <= 0) {
+      result = mid;
+      hi = mid - 1;
+    } else {
+      lo = mid + 1;
+    }
+  }
+  // result = number of boundaries that are < user_key
+  // If result == boundaries_.size(), it's the last partition
+  return std::min(result, num_partitions_ - 1);
+}
+
+void PartitionedMemTable::UpdateBoundaries(
+    const std::vector<std::string>& l1_boundary_keys) {
+  if (l1_boundary_keys.empty()) {
+    // No L1 files: keep boundaries_ empty for hash-based routing
+    return;
+  }
+  WriteLock();
+  // Take min(P-1, l1_boundary_keys.size()) boundaries from L1 file
+  // largest user keys. Each L1 file's largest user key becomes a
+  // partition boundary. When L1 has fewer files than P-1, we get
+  // fewer partitions (each covering a larger key range). This is
+  // fine — the partitions are still non-overlapping.
+  int num_bounds = std::min(num_partitions_ - 1,
+                            static_cast<int>(l1_boundary_keys.size()));
+  boundaries_.clear();
+  // Pick evenly spaced L1 boundary keys
+  for (int i = 0; i < num_bounds; i++) {
+    int idx = static_cast<int>(
+        static_cast<int64_t>(i + 1) * l1_boundary_keys.size() /
+        (num_bounds + 1));
+    idx = std::min(idx, static_cast<int>(l1_boundary_keys.size()) - 1);
+    boundaries_.push_back(l1_boundary_keys[idx]);
+  }
+  WriteUnlock();
+}
+
+Status PartitionedMemTable::Add(SequenceNumber seq, ValueType type,
+                                const Slice& key, const Slice& value,
+                                const ProtectionInfoKVOS64* kv_prot_info,
+                                bool allow_concurrent,
+                                MemTablePostProcessInfo* post_process_info,
+                                void** hint) {
+  // Extract user key from internal key
+  Slice user_key = ExtractUserKey(key);
+
+  // Hold read lock for the entire Add to prevent TakeFullSubTable
+  // from replacing the sub-table pointer while we are using it.
+  // Multiple Add() calls proceed concurrently (readers do not block).
+  ReadLock();
+
+  // Route to correct sub-table (boundaries_ also protected by ReadLock)
+  int idx = GetPartitionIndex(user_key);
+  assert(idx >= 0 && idx < num_partitions_);
+
+  Status s;
+  if (allow_concurrent) {
+    // CRITICAL: In the concurrent write path, MemTable::Add() accumulates
+    // entry counts in post_process_info instead of directly incrementing
+    // num_entries_. The caller later calls BatchPostProcess() on *us*
+    // (the PartitionedMemTable), NOT on the sub-table. Without this fix,
+    // the sub-table's num_entries_ is never updated, causing the
+    // flush_verify_memtable_count check to fail.
+    // Fix: use a local post_process_info and call BatchPostProcess on
+    // the sub-table immediately after Add().
+    MemTablePostProcessInfo local_ppi;
+    s = sub_tables_[idx]->Add(seq, type, key, value, kv_prot_info,
+                              true, &local_ppi, hint);
+    if (s.ok()) {
+      sub_tables_[idx]->BatchPostProcess(local_ppi);
+    }
+  } else {
+    // Non-concurrent path: Add() directly updates counters
+    s = sub_tables_[idx]->Add(seq, type, key, value, kv_prot_info,
+                              false, post_process_info, hint);
+  }
+
+  // Check if this sub-table is now full
+  if (s.ok() && sub_tables_[idx]->ShouldFlushNow()) {
+    int expected = -1;
+    // Try to claim this partition as the one needing flush
+    if (full_partition_idx_.compare_exchange_strong(expected, idx) ||
+        full_partition_idx_.load() == idx) {
+      partition_flush_pending_.store(true);
+    }
+  }
+
+  ReadUnlock();
+  return s;
+}
+
+bool PartitionedMemTable::ShouldFlushNow() {
+  ReadLock();
+  // Check if any sub-table is full
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i] && sub_tables_[i]->ShouldFlushNow()) {
+      int expected = -1;
+      if (full_partition_idx_.compare_exchange_strong(expected, i) ||
+          full_partition_idx_.load() == i) {
+        partition_flush_pending_.store(true);
+      }
+      ReadUnlock();
+      return true;
+    }
+  }
+  ReadUnlock();
+  return false;
+}
+
+bool PartitionedMemTable::ShouldScheduleFlush() const {
+  return partition_flush_pending_.load();
+}
+
+bool PartitionedMemTable::MarkFlushScheduled() {
+  bool expected = true;
+  return partition_flush_pending_.compare_exchange_strong(
+      expected, false, std::memory_order_relaxed, std::memory_order_relaxed);
+}
+
+void PartitionedMemTable::UpdateFlushState() {
+  if (!partition_flush_pending_.load()) {
+    ShouldFlushNow();  // This will set partition_flush_pending_ if needed
+  }
+}
+
+MemTable* PartitionedMemTable::TakeFullSubTable() {
+  int idx = full_partition_idx_.exchange(-1);
+  if (idx < 0 || idx >= num_partitions_) {
+    return nullptr;
+  }
+
+  // WriteLock: wait for all in-flight Add() calls to complete.
+  // This ensures no thread is using the old sub-table pointer
+  // when we replace it.
+  WriteLock();
+
+  // Find the full sub-table (it might be at a different index if multiple
+  // were full - check the claimed index first, then scan)
+  MemTable* full = nullptr;
+  int actual_idx = idx;
+
+  if (sub_tables_[idx] && sub_tables_[idx]->ShouldFlushNow()) {
+    full = sub_tables_[idx];
+    actual_idx = idx;
+  } else {
+    // Scan for any full sub-table
+    for (int i = 0; i < num_partitions_; i++) {
+      if (sub_tables_[i] && sub_tables_[i]->ShouldFlushNow()) {
+        full = sub_tables_[i];
+        actual_idx = i;
+        break;
+      }
+    }
+  }
+
+  if (full == nullptr) {
+    WriteUnlock();
+    return nullptr;
+  }
+
+  // Mark the sub-table as immutable (prevents future ShouldFlushNow)
+  full->MarkImmutable();
+  full->ConstructFragmentedRangeTombstones();
+
+  // Create replacement sub-table in the same slot.
+  // The full sub-table has refs=1 (owned by PartitionedMemTable).
+  // We transfer ownership to the caller (who will add it to the imm list,
+  // which takes over the reference).
+  SequenceNumber earliest = full->GetEarliestSequenceNumber();
+  sub_tables_[actual_idx] = CreateSubTable(earliest);
+
+  // Release WriteLock: allow new Add() calls to proceed.
+  // They will now see the new replacement sub-table.
+  WriteUnlock();
+
+  // Reset flush state
+  partition_flush_pending_.store(false);
+
+  // Return full sub-table with refs=1 (ownership transferred)
+  return full;
+}
+
+bool PartitionedMemTable::HasFullSubTable() const {
+  return full_partition_idx_.load() >= 0;
+}
+
+void PartitionedMemTable::ResetFlushState() {
+  partition_flush_pending_.store(false);
+  full_partition_idx_.store(-1);
+}
+
+InternalIterator* PartitionedMemTable::NewIterator(
+    const ReadOptions& read_options,
+    UnownedPtr<const SeqnoToTimeMapping> seqno_to_time_mapping, Arena* arena,
+    const SliceTransform* prefix_extractor, bool for_flush) {
+  // Merge all sub-table iterators
+  ReadLock();
+  std::vector<InternalIterator*> iters;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      iters.push_back(sub_tables_[i]->NewIterator(
+          read_options, seqno_to_time_mapping, arena, prefix_extractor,
+          for_flush));
+    }
+  }
+  ReadUnlock();
+  // Iterators hold their own refs to sub-tables, so safe after unlock
+  if (iters.empty()) {
+    return NewEmptyInternalIterator<Slice>(arena);
+  }
+  return NewMergingIterator(&comparator_, iters.data(),
+                            static_cast<int>(iters.size()), arena);
+}
+
+bool PartitionedMemTable::Get(const LookupKey& key, std::string* value,
+                              PinnableWideColumns* columns,
+                              std::string* timestamp, Status* s,
+                              MergeContext* merge_context,
+                              SequenceNumber* max_covering_tombstone_seq,
+                              SequenceNumber* seq,
+                              const ReadOptions& read_opts,
+                              bool immutable_memtable, ReadCallback* callback,
+                              bool* is_blob_index, bool do_merge) {
+  // Route to the correct sub-table by user key
+  ReadLock();
+  Slice user_key = key.user_key();
+  int idx = GetPartitionIndex(user_key);
+  assert(idx >= 0 && idx < num_partitions_);
+
+  bool found = false;
+  if (sub_tables_[idx]) {
+    found = sub_tables_[idx]->Get(
+        key, value, columns, timestamp, s, merge_context,
+        max_covering_tombstone_seq, seq, read_opts, immutable_memtable,
+        callback, is_blob_index, do_merge);
+  } else {
+    *s = Status::NotFound();
+  }
+  ReadUnlock();
+  return found;
+}
+
+size_t PartitionedMemTable::ApproximateMemoryUsage() {
+  ReadLock();
+  size_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->ApproximateMemoryUsage();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+size_t PartitionedMemTable::MemoryAllocatedBytes() const {
+  ReadLock();
+  size_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->MemoryAllocatedBytes();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+uint64_t PartitionedMemTable::NumEntries() const {
+  ReadLock();
+  uint64_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->NumEntries();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+uint64_t PartitionedMemTable::NumDeletion() const {
+  ReadLock();
+  uint64_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->NumDeletion();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+uint64_t PartitionedMemTable::NumRangeDeletion() const {
+  ReadLock();
+  uint64_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->NumRangeDeletion();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+uint64_t PartitionedMemTable::GetDataSize() const {
+  ReadLock();
+  uint64_t total = 0;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      total += sub_tables_[i]->GetDataSize();
+    }
+  }
+  ReadUnlock();
+  return total;
+}
+
+bool PartitionedMemTable::IsEmpty() const {
+  ReadLock();
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i] && !sub_tables_[i]->IsEmpty()) {
+      ReadUnlock();
+      return false;
+    }
+  }
+  ReadUnlock();
+  return true;
+}
+
+SequenceNumber PartitionedMemTable::GetFirstSequenceNumber() {
+  ReadLock();
+  SequenceNumber min_seq = kMaxSequenceNumber;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i] && !sub_tables_[i]->IsEmpty()) {
+      SequenceNumber s = sub_tables_[i]->GetFirstSequenceNumber();
+      if (s < min_seq) min_seq = s;
+    }
+  }
+  ReadUnlock();
+  return min_seq == kMaxSequenceNumber ? 0 : min_seq;
+}
+
+SequenceNumber PartitionedMemTable::GetEarliestSequenceNumber() {
+  ReadLock();
+  SequenceNumber min_seq = kMaxSequenceNumber;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      SequenceNumber s = sub_tables_[i]->GetEarliestSequenceNumber();
+      if (s < min_seq) min_seq = s;
+    }
+  }
+  ReadUnlock();
+  return min_seq == kMaxSequenceNumber ? 0 : min_seq;
+}
+
+uint64_t PartitionedMemTable::ApproximateOldestKeyTime() const {
+  ReadLock();
+  uint64_t min_time = UINT64_MAX;
+  for (int i = 0; i < num_partitions_; i++) {
+    if (sub_tables_[i]) {
+      uint64_t t = sub_tables_[i]->ApproximateOldestKeyTime();
+      if (t < min_time) min_time = t;
+    }
+  }
+  ReadUnlock();
+  return min_time == UINT64_MAX ? 0 : min_time;
+}
+
+size_t PartitionedMemTable::write_buffer_size() const {
+  return mutable_cf_options_.write_buffer_size;
+}
+
+}  // namespace ROCKSDB_NAMESPACE
